# Copy to .env (the setup script does this for you)
PORT=4000
# Local Postgres started by docker-compose.yml. For Render/Neon/Supabase paste their connection string here.
DATABASE_URL=postgresql://spendwise:spendwise@localhost:5432/spendwise
# Set to true when your hosted Postgres requires SSL (Render, Neon, Supabase)
DATABASE_SSL=false
# Long random string. `npm run setup` generates one for you.
JWT_SECRET=change-me
# Frontend URL(s) allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173
